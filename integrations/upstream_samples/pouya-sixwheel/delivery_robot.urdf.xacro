<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="delivery_robot">
  <xacro:include filename="$(find delivery_robot_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find delivery_robot_description)/urdf/inertial_macros.xacro"/>
  <xacro:include filename="$(find delivery_robot_description)/urdf/robot_meshes.xacro"/>
  <xacro:include filename="$(find delivery_robot_description)/urdf/robot_core.xacro"/>
  <xacro:include filename="$(find delivery_robot_description)/urdf/robot_sensors.xacro"/>
  <xacro:include filename="$(find delivery_robot_description)/urdf/robot_gazebo.xacro"/>

  <!-- Physical data from the real robot. -->
  <xacro:property name="robot_mass" value="25.0"/>
  <xacro:property name="max_payload_mass" value="12.0"/>
  <xacro:property name="max_linear_speed" value="2.0"/>
  <xacro:property name="drive_motor_power_each" value="150.0"/>
  <xacro:property name="drive_motor_count" value="2"/>
  <xacro:property name="active_suspension_motor_count" value="2"/>
  <xacro:property name="active_suspension_limit" value="0.296706"/>
  <xacro:property name="body_mass" value="18.7"/>
  <xacro:property name="wheel_mass" value="1.0"/>
  <xacro:property name="caster_mass" value="0.15"/>

  <!-- Collision dimensions around the real SolidWorks visual mesh. -->
  <xacro:property name="base_length" value="0.700"/>
  <xacro:property name="base_width" value="0.52907"/>
  <xacro:property name="base_height" value="0.590"/>
  <xacro:property name="body_collision_length" value="0.66"/>
  <xacro:property name="body_collision_width" value="0.38"/>
  <xacro:property name="body_collision_height" value="0.34"/>
  <xacro:property name="body_collision_z" value="0.065"/>
  <xacro:property name="wheel_radius" value="0.0975"/>
  <xacro:property name="wheel_width" value="0.0594"/>
  <xacro:property name="wheel_front_x_offset" value="0.225"/>
  <xacro:property name="wheel_middle_x_offset" value="0.000"/>
  <xacro:property name="wheel_rear_x_offset" value="-0.224"/>
  <xacro:property name="wheel_y_offset" value="0.235"/>
  <xacro:property name="wheel_z_offset" value="${wheel_radius}"/>
  <xacro:property name="caster_radius" value="0.035"/>
  <xacro:property name="caster_x_offset" value="0.27"/>

  <xacro:delivery_robot_core
    base_length="${base_length}"
    base_width="${base_width}"
    base_height="${base_height}"
    body_collision_length="${body_collision_length}"
    body_collision_width="${body_collision_width}"
    body_collision_height="${body_collision_height}"
    body_collision_z="${body_collision_z}"
    wheel_radius="${wheel_radius}"
    wheel_width="${wheel_width}"
    body_mass="${body_mass}"
    wheel_mass="${wheel_mass}"
    caster_mass="${caster_mass}"
    wheel_front_x_offset="${wheel_front_x_offset}"
    wheel_middle_x_offset="${wheel_middle_x_offset}"
    wheel_rear_x_offset="${wheel_rear_x_offset}"
    wheel_y_offset="${wheel_y_offset}"
    wheel_z_offset="${wheel_z_offset}"
    caster_radius="${caster_radius}"
    caster_x_offset="${caster_x_offset}"/>

  <xacro:delivery_robot_sensors base_height="${base_height}"/>

  <xacro:delivery_robot_gazebo
    wheel_radius="${wheel_radius}"
    wheel_separation="${2 * wheel_y_offset}"
    max_linear_speed="${max_linear_speed}"/>
</robot>
